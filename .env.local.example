# Copy this file to .env.local and fill in your own Supabase project values.
# Settings -> API in your Supabase project dashboard has both of these.
# The anon/public key is safe to expose in frontend code by design - do NOT put
# the service_role key or your DB password here or anywhere in this app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
